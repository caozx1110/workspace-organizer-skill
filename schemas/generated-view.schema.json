{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caozx1110/workspace-organizer-skill/schemas/generated-view.schema.json",
  "title": "workspace-organizer generated views v1",
  "oneOf": [
    {
      "$ref": "#/$defs/todoView"
    },
    {
      "$ref": "#/$defs/timelineView"
    },
    {
      "$ref": "#/$defs/materialView"
    }
  ],
  "$defs": {
    "taskId": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\).+$"
    },
    "taskRecordPath": {
      "allOf": [
        {
          "$ref": "#/$defs/relativePath"
        },
        {
          "pattern": "(?:^|/)TASK\\.md$"
        }
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "nextAction": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[^\\r\\n]+$"
    },
    "openStatus": {
      "enum": [
        "planned",
        "active",
        "waiting",
        "blocked"
      ]
    },
    "priority": {
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "visibleSensitivity": {
      "enum": [
        "public",
        "internal"
      ]
    },
    "todoItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "status",
        "priority",
        "due",
        "sensitivity",
        "next_action",
        "record"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "status": {
          "$ref": "#/$defs/openStatus"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "due": {
          "oneOf": [
            {
              "type": "string",
              "format": "date"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/visibleSensitivity"
        },
        "next_action": {
          "$ref": "#/$defs/nextAction"
        },
        "record": {
          "$ref": "#/$defs/taskRecordPath"
        }
      }
    },
    "timelineItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "event",
        "id",
        "title",
        "status",
        "priority",
        "sensitivity",
        "record"
      ],
      "properties": {
        "date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "event": {
          "const": "due"
        },
        "id": {
          "$ref": "#/$defs/taskId"
        },
        "title": {
          "$ref": "#/$defs/title"
        },
        "status": {
          "$ref": "#/$defs/openStatus"
        },
        "priority": {
          "$ref": "#/$defs/priority"
        },
        "sensitivity": {
          "$ref": "#/$defs/visibleSensitivity"
        },
        "record": {
          "$ref": "#/$defs/taskRecordPath"
        }
      }
    },
    "materialItem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "role",
        "task_id",
        "sensitivity",
        "bytes",
        "sha256"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/relativePath"
        },
        "role": {
          "enum": [
            "inputs",
            "work",
            "deliverables",
            "records",
            "history",
            "library"
          ]
        },
        "task_id": {
          "oneOf": [
            {
              "$ref": "#/$defs/taskId"
            },
            {
              "type": "null"
            }
          ]
        },
        "sensitivity": {
          "$ref": "#/$defs/visibleSensitivity"
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "library"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "task_id": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "task_id": {
                "$ref": "#/$defs/taskId"
              }
            }
          }
        }
      ]
    },
    "todoView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "view",
        "profile",
        "source_sha256",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "view": {
          "const": "todo"
        },
        "profile": {
          "const": "default"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/todoItem"
          }
        }
      }
    },
    "timelineView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "view",
        "profile",
        "source_sha256",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "view": {
          "const": "timeline"
        },
        "profile": {
          "const": "default"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/timelineItem"
          }
        }
      }
    },
    "materialView": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "view",
        "profile",
        "source_sha256",
        "items"
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "view": {
          "const": "materials"
        },
        "profile": {
          "const": "default"
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "items": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/materialItem"
          }
        }
      }
    }
  }
}
