{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caozx1110/workspace-organizer-skill/schemas/task.schema.json",
  "title": "workspace-organizer TASK.md front matter v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "status",
    "area",
    "type",
    "priority",
    "due",
    "sensitivity",
    "next_action",
    "updated",
    "closed_at",
    "archived_at"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 64,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\r\\n]+$"
    },
    "status": {
      "enum": [
        "planned",
        "active",
        "waiting",
        "blocked",
        "completed",
        "cancelled",
        "archived"
      ]
    },
    "area": {
      "$ref": "#/$defs/slug"
    },
    "type": {
      "$ref": "#/$defs/slug"
    },
    "priority": {
      "enum": [
        "urgent",
        "high",
        "normal",
        "low"
      ]
    },
    "due": {
      "oneOf": [
        {
          "$ref": "#/$defs/date"
        },
        {
          "type": "null"
        }
      ]
    },
    "sensitivity": {
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "next_action": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "pattern": "^[^\\r\\n]+$"
        },
        {
          "type": "null"
        }
      ]
    },
    "updated": {
      "$ref": "#/$defs/timestamp"
    },
    "closed_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "archived_at": {
      "oneOf": [
        {
          "$ref": "#/$defs/timestamp"
        },
        {
          "type": "null"
        }
      ]
    },
    "tags": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/slug"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "planned",
              "active",
              "waiting",
              "blocked"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "next_action": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[^\\r\\n]+$"
          },
          "closed_at": {
            "type": "null"
          },
          "archived_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "completed",
              "cancelled"
            ]
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "next_action": {
            "type": "null"
          },
          "closed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "archived_at": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "archived"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "next_action": {
            "type": "null"
          },
          "closed_at": {
            "$ref": "#/$defs/timestamp"
          },
          "archived_at": {
            "$ref": "#/$defs/timestamp"
          }
        }
      }
    }
  ],
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 1,
      "maxLength": 48,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:Z|[+-][0-9]{2}:[0-9]{2})$"
    }
  }
}
