{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/caozx1110/workspace-organizer-skill/schemas/capture-v2.schema.json",
  "title": "workspace-organizer clean-slate Capture note v2",
  "type": "object",
  "additionalProperties": true,
  "required": ["kind", "schema_version", "capture_id", "title", "status", "capture_type", "payload_path", "source", "sensitivity", "captured_at", "updated_at", "triaged_at", "disposition", "target_task", "tags"],
  "properties": {
    "kind": {"const": "capture"},
    "schema_version": {"const": 2},
    "capture_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"},
    "title": {"type": "string", "minLength": 1, "maxLength": 240, "pattern": "^[^\\r\\n]+$"},
    "status": {"enum": ["inbox", "deferred", "triaged"]},
    "capture_type": {"enum": ["text", "file", "link", "email", "transcript", "other"]},
    "payload_path": {"$ref": "#/$defs/pathOrNull"},
    "source": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "object", "additionalProperties": true}]},
    "sensitivity": {"enum": ["public", "internal", "confidential", "restricted"]},
    "agent_access": {"enum": ["none", "metadata", "content"], "default": "metadata"},
    "captured_at": {"$ref": "#/$defs/timestamp"},
    "updated_at": {"$ref": "#/$defs/timestamp"},
    "triaged_at": {"$ref": "#/$defs/timestampOrNull"},
    "disposition": {"enum": ["task", "artifact", "library", "defer", null]},
    "target_task": {"oneOf": [{"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"}, {"type": "null"}]},
    "tags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1, "maxLength": 128}}
  },
  "allOf": [
    {"if": {"properties": {"capture_type": {"const": "file"}}}, "then": {"properties": {"payload_path": {"type": "string", "minLength": 1}}}},
    {"if": {"properties": {"status": {"const": "inbox"}}}, "then": {"properties": {"triaged_at": {"type": "null"}, "disposition": {"type": "null"}}}},
    {"if": {"properties": {"status": {"const": "deferred"}}}, "then": {"properties": {"triaged_at": {"type": "null"}, "disposition": {"enum": ["defer", null]}}}},
    {"if": {"properties": {"status": {"const": "triaged"}}}, "then": {"required": ["triaged_at", "disposition"]}}
  ],
  "$defs": {
    "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*\\u0000).+$"},
    "pathOrNull": {"oneOf": [{"$ref": "#/$defs/path"}, {"type": "null"}]},
    "timestamp": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]{1,6})?(?:Z|[+-][0-9]{2}:[0-9]{2})$"},
    "timestampOrNull": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
  }
}
